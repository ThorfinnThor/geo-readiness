# ─────────────────────────────────────────────────────────────
# GEO AI Search Readiness — environment template
# Copy to .env / .env.local and fill in. NEVER commit real secrets.
# The webhook is the payment source of truth (Golden Rule 11).
# ─────────────────────────────────────────────────────────────

# --- Core ---
APP_ENV=development                     # development | staging | production
METHODOLOGY_VERSION=geo-readiness-v2     # default as of the 2026-08-20 switch; v1 still selectable
LOG_LEVEL=info

# --- Database (Supabase Postgres; local dev uses docker-compose Postgres) ---
# Local default matches docker-compose.yml:
DATABASE_URL=postgresql://geo:geo@localhost:5432/geo
# Async driver URL used by the Python worker (SQLAlchemy asyncpg):
DATABASE_URL_ASYNC=postgresql+asyncpg://geo:geo@localhost:5432/geo

# --- Web (Next.js on Vercel) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Worker wake-up (GitHub Actions worker; staging) ---
# When a scan is enqueued the web app fires a repository_dispatch so the
# Actions workflow drains the queue immediately. Leave unset locally (skips).
# Token needs repo Contents:write (fine-grained PAT) or classic `repo` scope.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=ThorfinnThor/geo-readiness

# (Unused: the original design imagined a web->worker HTTP service. Web and
# worker now communicate only through the Postgres job queue.)
# WORKER_BASE_URL=
# WORKER_INTERNAL_TOKEN=

# --- Scan budgets (server-side; Free Scan Economics Guard §38) ---
FREE_MAX_PAGES=12
FREE_MAX_RENDER=2
FREE_MAX_BYTES=26214400
FREE_MAX_RUNTIME_SECONDS=120
FREE_DOMAIN_COOLDOWN_HOURS=24
FREE_QUEUE_PRIORITY=10

# --- Pricing (config, not methodology §2.2) ---
GEO_FULL_AUDIT_PRICE_EUR=249

# --- Stripe (test keys locally; live keys only in production) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GEO_READINESS_FULL=
